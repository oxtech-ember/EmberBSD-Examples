foreach(required C_PROGRAM CXX_PROGRAM CHECKER MODELS WORK)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run expected)
    execute_process(COMMAND "${program}" ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${diagnostics}\n${output}")
    endif()
    set(last_diagnostics "${diagnostics}" PARENT_SCOPE)
endfunction()
function(check expected batch repeats path)
    execute_process(COMMAND "${CHECKER}" "${batch}" "${repeats}" "${path}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Checker expected ${expected}, got ${status}: ${diagnostics}\n${output}")
    endif()
endfunction()
set(model "${MODELS}/tiny-mlp.onnx")
foreach(language C CXX)
    set(program "${${language}_PROGRAM}")
    foreach(batch 1 3 32)
        if(batch EQUAL 1)
            set(repeats 1)
        elseif(batch EQUAL 3)
            set(repeats 100)
        else()
            set(repeats 4)
        endif()
        set(csv "${WORK}/${language}-${batch}.csv")
        run(0 "${model}" "${batch}" "${repeats}" "${csv}")
        check(0 "${batch}" "${repeats}" "${csv}")
        if(NOT last_diagnostics MATCHES "ONNX Runtime 1[.]31[.]0; provider CPUExecutionProvider")
            message(FATAL_ERROR "Unexpected Runtime version or provider: ${last_diagnostics}")
        endif()
    endforeach()
    foreach(fault --wrong-shape --missing-input --missing-output malformed missing-file)
        if(fault STREQUAL malformed)
            set(fault_model "${MODELS}/malformed.onnx")
            set(fault_argument)
            set(ort_code 7) # ORT_INVALID_PROTOBUF
        elseif(fault STREQUAL missing-file)
            set(fault_model "${MODELS}/missing.onnx")
            set(fault_argument)
            set(ort_code 3) # ORT_NO_SUCHFILE
        else()
            set(fault_model "${model}")
            set(fault_argument "${fault}")
            set(ort_code 2) # ORT_INVALID_ARGUMENT
        endif()
        file(REMOVE "${WORK}/not-created.csv")
        run(65 "${fault_model}" 3 2 "${WORK}/not-created.csv" ${fault_argument})
        if(EXISTS "${WORK}/not-created.csv" OR
                NOT last_diagnostics MATCHES "ONNX Runtime \\[${ort_code}\\]:")
            message(FATAL_ERROR "Rejected inference created output or lacked a Runtime error")
        endif()
        file(WRITE "${WORK}/preserved.csv" "existing output\n")
        run(65 "${fault_model}" 3 2 "${WORK}/preserved.csv" ${fault_argument})
        file(READ "${WORK}/preserved.csv" preserved)
        if(NOT preserved STREQUAL "existing output\n")
            message(FATAL_ERROR "Rejected inference modified existing output")
        endif()
    endforeach()
    run(64)
    run(64 --unknown)
    run(64 "${model}" 0 1 "${WORK}/bad.csv")
    run(64 "${model}" 33 1 "${WORK}/bad.csv")
    run(64 "${model}" -1 1 "${WORK}/bad.csv")
    run(64 "${model}" 3x 1 "${WORK}/bad.csv")
    run(64 "${model}" 3 0 "${WORK}/bad.csv")
    run(64 "${model}" 3 1001 "${WORK}/bad.csv")
    run(64 "${model}" 3 1 "${WORK}/bad.csv" --unknown)
    run(64 "${model}" 3 1 "${WORK}/bad.csv" --wrong-shape --missing-input)
    execute_process(COMMAND "${program}" "${model}" 3 1 "" RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT status STREQUAL "64" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Empty output path was accepted: ${diagnostics}")
    endif()
    run(74 "${model}" 1 1 "${WORK}/missing-directory/output.csv")
    run(74 "${model}" 1 1 "${WORK}")
    if(EXISTS /dev/full)
        run(74 "${model}" 1 1 /dev/full)
        execute_process(COMMAND "${program}" --help OUTPUT_FILE /dev/full
            RESULT_VARIABLE status ERROR_VARIABLE diagnostics)
        if(NOT status STREQUAL "74")
            message(FATAL_ERROR "Help output failure was not reported: ${diagnostics}")
        endif()
    endif()
    execute_process(COMMAND "${program}" --help RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT status STREQUAL "0" OR NOT output MATCHES "^Usage:" OR NOT diagnostics STREQUAL "")
        message(FATAL_ERROR "Help did not succeed: ${diagnostics}")
    endif()
endforeach()
foreach(batch 1 3 32)
    file(READ "${WORK}/C-${batch}.csv" c_results)
    file(READ "${WORK}/CXX-${batch}.csv" cxx_results)
    if(NOT c_results STREQUAL cxx_results)
        message(FATAL_ERROR "C and C++ results differ for batch ${batch}")
    endif()
endforeach()
# Verify that the independent checker detects incorrect finite values and
# nonfinite values. Also reject wrong ordering, duplicate, and missing rows.
file(READ "${WORK}/C-1.csv" baseline)
string(REPLACE "\n" ";" baseline_rows "${baseline}")
list(GET baseline_rows 1 baseline_row)
string(REPLACE "," ";" baseline_fields "${baseline_row}")
foreach(column RANGE 2 6)
    foreach(value 99 nan inf -inf)
        set(fields "${baseline_fields}")
        list(REMOVE_AT fields ${column})
        list(INSERT fields ${column} "${value}")
        string(JOIN "," corrupted_row ${fields})
        string(REPLACE "${baseline_row}" "${corrupted_row}" corrupted "${baseline}")
        file(WRITE "${WORK}/corrupted.csv" "${corrupted}")
        check(1 1 1 "${WORK}/corrupted.csv")
    endforeach()
endforeach()
file(WRITE "${WORK}/truncated.csv" "run,row,x0,x1,x2,y0,y1\n")
check(1 1 1 "${WORK}/truncated.csv")
file(WRITE "${WORK}/extra.csv" "${baseline}0,0,-2,-3,-1.5,1,1\n")
check(1 1 1 "${WORK}/extra.csv")
string(REPLACE "\n0,0," "\n1,0," wrong_order "${baseline}")
file(WRITE "${WORK}/wrong-order.csv" "${wrong_order}")
check(1 1 1 "${WORK}/wrong-order.csv")
