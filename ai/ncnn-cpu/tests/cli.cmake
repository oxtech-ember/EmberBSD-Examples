file(MAKE_DIRECTORY "${WORK}")
function(run_pass)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Command failed (${status}): ${ARGV}\n${out}\n${err}")
    endif()
endfunction()
function(run_fail expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${out}\n${err}")
    endif()
endfunction()
set(graph "${MODELS}/tiny-cnn.param")
set(weights "${MODELS}/tiny-cnn.bin")
foreach(program "${C_PROGRAM}" "${CXX_PROGRAM}")
    get_filename_component(name "${program}" NAME)
    run_pass("${program}" --help)
    foreach(case "0,1,1" "41,7,9" "100000,64,2")
        string(REPLACE "," ";" args "${case}")
        set(output "${WORK}/${name}-${case}.csv")
        run_pass("${program}" "${graph}" "${weights}" "${output}" ${args})
        run_pass("${CHECKER}" "${output}" ${args})
    endforeach()
    set(sentinel "${WORK}/${name}-preserved.csv")
    file(WRITE "${sentinel}" "preserve this output\n")
    run_fail(65 "${program}" "${MODELS}/absent.param" "${weights}" "${sentinel}" 0 1 1)
    run_fail(65 "${program}" "${graph}" "${MODELS}/absent.bin" "${sentinel}" 0 1 1)
    run_fail(65 "${program}" "${MODELS}/malformed.param" "${weights}" "${sentinel}" 0 1 1)
    run_fail(65 "${program}" "${graph}" "${MODELS}/truncated.bin" "${sentinel}" 0 1 1)
    run_fail(65 "${program}" "${graph}" "${MODELS}/nonfinite.bin" "${sentinel}" 0 1 1)
    run_fail(65 "${program}" "${graph}" "${weights}" "${sentinel}" 0 1 1 absent prob)
    run_fail(65 "${program}" "${graph}" "${weights}" "${sentinel}" 0 1 1 input absent)
    foreach(bad "-1,1,1" "100001,1,1" "0,0,1" "0,65,1" "0,1,0" "0,1,1001" "0,1junk,1" "0,1,-1")
        string(REPLACE "," ";" args "${bad}")
        run_fail(64 "${program}" "${graph}" "${weights}" "${sentinel}" ${args})
    endforeach()
    run_fail(64 "${program}")
    run_fail(64 "${program}" "${graph}" "${weights}" "${graph}" 0 1 1)
    run_fail(64 "${program}" "${graph}" "${weights}" "${weights}" 0 1 1)
    run_fail(74 "${program}" "${graph}" "${weights}" "${WORK}/absent/output.csv" 0 1 1)
    file(READ "${sentinel}" preserved)
    if(NOT preserved STREQUAL "preserve this output\n")
        message(FATAL_ERROR "Failed commands changed the output file")
    endif()
endforeach()
foreach(case "0,1,1" "41,7,9" "100000,64,2")
    file(SHA256 "${WORK}/ncnn-cpu-c-${case}.csv" a)
    file(SHA256 "${WORK}/ncnn-cpu-cxx-${case}.csv" b)
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "C and C++ outputs differ for ${case}")
    endif()
endforeach()
file(READ "${WORK}/ncnn-cpu-c-0,1,1.csv" good)
string(REGEX REPLACE "\n0,0,0,[^,]+," "\n0,0,0,999," wrong "${good}")
file(WRITE "${WORK}/wrong.csv" "${wrong}")
run_fail(1 "${CHECKER}" "${WORK}/wrong.csv" 0 1 1)
file(WRITE "${WORK}/extra.csv" "${good}0,0,0,0,0,0,0,0,0\n")
run_fail(1 "${CHECKER}" "${WORK}/extra.csv" 0 1 1)
string(REGEX REPLACE "\n0,0,0," "\n0,1,0," wrong_order "${good}")
file(WRITE "${WORK}/order.csv" "${wrong_order}")
run_fail(1 "${CHECKER}" "${WORK}/order.csv" 0 1 1)
string(REGEX REPLACE "\n0,0,0,[^,]+," "\n0,0,0,nan," nonfinite "${good}")
file(WRITE "${WORK}/nonfinite.csv" "${nonfinite}")
run_fail(1 "${CHECKER}" "${WORK}/nonfinite.csv" 0 1 1)
file(WRITE "${WORK}/empty.csv" "seed,sample,repeat,logit0,logit1,logit2,prob0,prob1,prob2\n")
run_fail(1 "${CHECKER}" "${WORK}/empty.csv" 0 1 1)
message(STATUS "PASS: 192 scalar-checked rows per API, identical C/C++ CSV, 38 CLI failures preserve output, five checker red controls")
