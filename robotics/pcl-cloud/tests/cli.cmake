if(NOT DEFINED PROGRAM OR NOT DEFINED CHECKER OR NOT DEFINED WORK)
    message(FATAL_ERROR "PROGRAM, CHECKER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
function(run expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${diagnostics}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(check expected case path)
    execute_process(COMMAND "${CHECKER}" --case "${case}" --input "${path}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "CSV checker expected ${expected}, got ${status}: ${diagnostics}")
    endif()
endfunction()
foreach(case filter registration empty-filter)
    run(0 --case "${case}" --output "${WORK}/${case}.csv")
    if(NOT last_output STREQUAL "")
        message(FATAL_ERROR "File-output mode wrote to stdout")
    endif()
    check(0 "${case}" "${WORK}/${case}.csv")
    file(READ "${WORK}/${case}.csv" saved)
    run(0 --case "${case}" --output -)
    if(NOT last_output STREQUAL saved)
        message(FATAL_ERROR "CSV differs between file and stdout")
    endif()
    execute_process(COMMAND "${CHECKER}" --case "${case}" --input -
        INPUT_FILE "${WORK}/${case}.csv" RESULT_VARIABLE stdin_status)
    if(NOT "${stdin_status}" STREQUAL "0")
        message(FATAL_ERROR "Checker standard input failed")
    endif()
    file(WRITE "${WORK}/extra.csv" "${saved}extra\n")
    check(1 "${case}" "${WORK}/extra.csv")
    file(WRITE "${WORK}/empty.csv" "")
    check(1 "${case}" "${WORK}/empty.csv")
endforeach()
file(READ "${WORK}/empty-filter.csv" empty_csv)
if(NOT empty_csv STREQUAL "case,kind,index,a,b,c,d\n")
    message(FATAL_ERROR "Empty filtering must export a header only")
endif()
foreach(case filter registration)
    file(READ "${WORK}/${case}.csv" saved)
    file(STRINGS "${WORK}/${case}.csv" lines)
    if(case STREQUAL "filter")
        set(selected_rows 1 2)
    else()
        # First source, target and aligned point; every matrix row; fitness.
        set(selected_rows 1 31 61 91 92 93 94 95)
    endif()
    foreach(row_index IN LISTS selected_rows)
        list(GET lines ${row_index} original)
        string(REPLACE "," ";" original_fields "${original}")
        foreach(column RANGE 3 6)
            foreach(bad 10 nan inf -inf)
                set(changed_fields "${original_fields}")
                list(REMOVE_AT changed_fields ${column})
                list(INSERT changed_fields ${column} "${bad}")
                string(JOIN "," changed ${changed_fields})
                string(REPLACE "${original}" "${changed}" corrupted "${saved}")
                file(WRITE "${WORK}/corrupted.csv" "${corrupted}")
                check(1 "${case}" "${WORK}/corrupted.csv")
            endforeach()
        endforeach()
    endforeach()
    # A valid coordinate with the wrong point label is still invalid output.
    string(REPLACE "${case}," "other-case," corrupted "${saved}")
    file(WRITE "${WORK}/wrong-case.csv" "${corrupted}")
    check(1 "${case}" "${WORK}/wrong-case.csv")
endforeach()
run(0)
file(READ "${WORK}/registration.csv" registration_csv)
if(NOT last_output STREQUAL registration_csv)
    message(FATAL_ERROR "The default case must export registration to stdout")
endif()
run(0 --help)
if(NOT last_output MATCHES "^Usage: ember-pcl-cloud ")
    message(FATAL_ERROR "Missing help text")
endif()
file(REMOVE "${WORK}/not-created.csv")
run(65 --case no-correspondence --output "${WORK}/not-created.csv")
if(EXISTS "${WORK}/not-created.csv" OR NOT last_output STREQUAL "")
    message(FATAL_ERROR "A rejected alignment created output")
endif()
file(WRITE "${WORK}/preserved.csv" "existing output\n")
run(65 --case no-correspondence --output "${WORK}/preserved.csv")
file(READ "${WORK}/preserved.csv" preserved)
if(NOT preserved STREQUAL "existing output\n")
    message(FATAL_ERROR "A rejected alignment changed an existing file")
endif()
run(64 --unknown)
run(64 --case)
run(64 --output)
run(64 --case nowhere)
run(64 --case filter --case registration)
run(64 --output - --output -)
run(64 --help --case filter)
execute_process(COMMAND "${PROGRAM}" --output "" RESULT_VARIABLE empty_status
    OUTPUT_VARIABLE empty_output ERROR_VARIABLE empty_diagnostics)
if(NOT "${empty_status}" STREQUAL "64" OR NOT empty_output STREQUAL "")
    message(FATAL_ERROR "An empty output path was accepted: ${empty_diagnostics}")
endif()
run(74 --case filter --output "${WORK}/missing-directory/cloud.csv")
run(74 --case filter --output "${WORK}")
execute_process(COMMAND /bin/sh -c "exec 1>&-; exec \"$1\" --case filter --output -"
    cloud-closed-stdout "${PROGRAM}" RESULT_VARIABLE closed_status ERROR_VARIABLE closed_diagnostics)
if(NOT "${closed_status}" STREQUAL "74")
    message(FATAL_ERROR "Closed stdout was not rejected: ${closed_diagnostics}")
endif()
if(EXISTS "/dev/full")
    run(74 --case filter --output /dev/full)
    execute_process(COMMAND "${PROGRAM}" --case filter --output -
        OUTPUT_FILE "/dev/full" RESULT_VARIABLE full_status ERROR_VARIABLE full_diagnostics)
    if(NOT "${full_status}" STREQUAL "74")
        message(FATAL_ERROR "stdout write failure was not rejected: ${full_diagnostics}")
    endif()
endif()
check(74 filter "${WORK}/missing.csv")
execute_process(COMMAND "${CHECKER}" --case no-correspondence --input "${WORK}/filter.csv"
    RESULT_VARIABLE invalid_checker)
if(NOT "${invalid_checker}" STREQUAL "64")
    message(FATAL_ERROR "Checker accepted an unsupported case")
endif()
