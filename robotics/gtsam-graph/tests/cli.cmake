if(NOT DEFINED PROGRAM OR NOT DEFINED CHECKER OR NOT DEFINED WORK)
    message(FATAL_ERROR "PROGRAM, CHECKER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
function(run expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${diagnostics}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(check expected case path)
    execute_process(COMMAND "${CHECKER}" "${case}" "${path}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "CSV checker expected ${expected}, got ${status}: ${diagnostics}")
    endif()
endfunction()
foreach(case linear pose)
    run(0 --case "${case}" --output "${WORK}/${case}.csv")
    if(NOT last_output STREQUAL "")
        message(FATAL_ERROR "File-output mode wrote to stdout")
    endif()
    check(0 "${case}" "${WORK}/${case}.csv")
    file(READ "${WORK}/${case}.csv" saved)
    run(0 --case "${case}" --output -)
    if(NOT last_output STREQUAL saved)
        message(FATAL_ERROR "CSV differs between file and stdout")
    endif()
    # The independent checker must reject finite but incorrect states as well
    # as NaN and both infinities. Do not derive expected values from this CSV.
    foreach(bad 10 nan inf -inf)
        string(REGEX REPLACE "${case},optimized,0,[^,]*" "${case},optimized,0,${bad}" corrupted "${saved}")
        file(WRITE "${WORK}/corrupted.csv" "${corrupted}")
        check(1 "${case}" "${WORK}/corrupted.csv")
    endforeach()
    file(WRITE "${WORK}/extra.csv" "${saved}extra\n")
    check(1 "${case}" "${WORK}/extra.csv")
endforeach()
# Exercise each exported covariance coefficient against nonfinite values.
file(STRINGS "${WORK}/pose.csv" pose_lines)
list(GET pose_lines 4 anchor)
string(REPLACE "," ";" anchor_fields "${anchor}")
foreach(column RANGE 7 12)
    foreach(bad nan inf -inf)
        set(fields "${anchor_fields}")
        list(REMOVE_AT fields ${column})
        list(INSERT fields ${column} "${bad}")
        string(JOIN "," bad_anchor ${fields})
        file(READ "${WORK}/pose.csv" saved)
        string(REPLACE "${anchor}" "${bad_anchor}" corrupted "${saved}")
        file(WRITE "${WORK}/corrupted.csv" "${corrupted}")
        check(1 pose "${WORK}/corrupted.csv")
    endforeach()
endforeach()
run(0 --help)
if(NOT last_output MATCHES "^Usage: ember-gtsam-graph ")
    message(FATAL_ERROR "Missing help text")
endif()
foreach(case underconstrained missing-state)
    file(REMOVE "${WORK}/not-created.csv")
    run(65 --case "${case}" --output "${WORK}/not-created.csv")
    if(EXISTS "${WORK}/not-created.csv" OR NOT last_output STREQUAL "")
        message(FATAL_ERROR "A rejected graph created output")
    endif()
    file(WRITE "${WORK}/preserved.csv" "existing output\n")
    run(65 --case "${case}" --output "${WORK}/preserved.csv")
    file(READ "${WORK}/preserved.csv" preserved)
    if(NOT preserved STREQUAL "existing output\n")
        message(FATAL_ERROR "A rejected graph changed an existing file")
    endif()
endforeach()
run(64 --unknown)
run(64 --case)
run(64 --output)
run(64 --case nowhere)
run(64 --case linear --case pose)
run(64 --output - --output -)
run(64 --help --case pose)
execute_process(COMMAND "${PROGRAM}" --output "" RESULT_VARIABLE empty_status
    OUTPUT_VARIABLE empty_output ERROR_VARIABLE empty_diagnostics)
if(NOT "${empty_status}" STREQUAL "64" OR NOT empty_output STREQUAL "")
    message(FATAL_ERROR "An empty output path was accepted: ${empty_diagnostics}")
endif()
run(74 --case linear --output "${WORK}/missing-directory/graph.csv")
run(74 --case linear --output "${WORK}")
execute_process(COMMAND /bin/sh -c "exec 1>&-; exec \"$1\" --case linear --output -"
    graph-closed-stdout "${PROGRAM}" RESULT_VARIABLE closed_status ERROR_VARIABLE closed_diagnostics)
if(NOT "${closed_status}" STREQUAL "74")
    message(FATAL_ERROR "Closed stdout was not rejected: ${closed_diagnostics}")
endif()
if(EXISTS "/dev/full")
    run(74 --case linear --output /dev/full)
    execute_process(COMMAND "${PROGRAM}" --case linear --output -
        OUTPUT_FILE "/dev/full" RESULT_VARIABLE full_status ERROR_VARIABLE full_diagnostics)
    if(NOT "${full_status}" STREQUAL "74")
        message(FATAL_ERROR "stdout write failure was not rejected: ${full_diagnostics}")
    endif()
endif()
