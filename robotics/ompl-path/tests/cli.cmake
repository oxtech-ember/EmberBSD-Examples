if(NOT DEFINED PROGRAM OR NOT DEFINED WORK)
    message(FATAL_ERROR "PROGRAM and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
function(run expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${diagnostics}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

run(0 --output "${WORK}/path.csv")
if(NOT last_output STREQUAL "")
    message(FATAL_ERROR "File-output mode wrote to stdout")
endif()
file(READ "${WORK}/path.csv" saved)
if(NOT saved MATCHES "^x,y\n0[.]1[0-9]*,0[.]5\n" OR NOT saved MATCHES ",0[.]5\n$")
    message(FATAL_ERROR "CSV header or endpoints are missing")
endif()
run(0 --output -)
if(NOT last_output STREQUAL saved)
    message(FATAL_ERROR "Seeded file and stdout paths differ")
endif()
run(3 --case invalid-goal --output "${WORK}/not-created.csv")
run(3 --case blocked --output "${WORK}/not-created.csv")
if(EXISTS "${WORK}/not-created.csv")
    message(FATAL_ERROR "A negative planning case created output")
endif()
file(WRITE "${WORK}/preserved.csv" "existing output\n")
run(3 --case invalid-goal --output "${WORK}/preserved.csv")
file(READ "${WORK}/preserved.csv" preserved)
if(NOT preserved STREQUAL "existing output\n")
    message(FATAL_ERROR "A negative planning case changed an existing file")
endif()
run(2 --unknown)
run(2 --case)
run(2 --case nowhere)
run(2 --output)
execute_process(COMMAND "${PROGRAM}" --output "" RESULT_VARIABLE empty_status
    OUTPUT_VARIABLE empty_output ERROR_VARIABLE empty_diagnostics)
if(NOT "${empty_status}" STREQUAL "2" OR NOT empty_output STREQUAL "")
    message(FATAL_ERROR "An empty output path was accepted: ${empty_diagnostics}")
endif()
run(2 --case path --case path)
run(4 --output "${WORK}/missing-directory/path.csv")
if(EXISTS "/dev/full")
    run(4 --output /dev/full)
endif()
