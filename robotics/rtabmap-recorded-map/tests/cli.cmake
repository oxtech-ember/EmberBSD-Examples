foreach(required PROGRAM CHECKER FIXTURE WORK)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
set(work_base "${WORK}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(WORK "${work_base}/run-${run_id}")
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${work_base}/latest-run.txt" "${WORK}\n")
function(run expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${status}: ${ARGN}\n${diagnostics}\n${output}")
    endif()
endfunction()
function(check expected path)
    execute_process(COMMAND "${CHECKER}" --dataset "${FIXTURE}" --results "${path}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "Checker expected ${expected}, got ${status}: ${diagnostics}")
    endif()
endfunction()
run(0 --dataset "${FIXTURE}" --output "${WORK}/validated" --validate-only)
if(EXISTS "${WORK}/validated")
    message(FATAL_ERROR "Validation-only mode created output")
endif()
run(0 --dataset "${FIXTURE}" --output "${WORK}/map")
check(0 "${WORK}/map")
run(74 --dataset "${FIXTURE}" --output "${WORK}/map")
check(0 "${WORK}/map")
run(64)
run(64 --unknown)
run(64 --dataset "${FIXTURE}")
run(64 --dataset "${FIXTURE}" --output)
run(64 --dataset "${FIXTURE}" --output "${WORK}/bad" --validate-only --validate-only)
run(65 --dataset "${WORK}/missing-dataset" --output "${WORK}/not-created")
if(EXISTS "${WORK}/not-created")
    message(FATAL_ERROR "Invalid input created output")
endif()
# Fixture images stay unchanged. Negative fixtures refer to the same images.
file(MAKE_DIRECTORY "${WORK}/bad-input")
file(CREATE_LINK "${FIXTURE}/rgb" "${WORK}/bad-input/rgb" SYMBOLIC)
file(CREATE_LINK "${FIXTURE}/depth" "${WORK}/bad-input/depth" SYMBOLIC)
file(READ "${FIXTURE}/frames.tsv" frames)
file(WRITE "${WORK}/bad-input/frames.tsv" "invalid header\n")
run(65 --dataset "${WORK}/bad-input" --output "${WORK}/not-created")
string(REGEX REPLACE "rgb/[0-9.]+[.]png" "rgb/missing.png" missing "${frames}")
file(WRITE "${WORK}/bad-input/frames.tsv" "${missing}")
run(65 --dataset "${WORK}/bad-input" --output "${WORK}/not-created")
file(WRITE "${WORK}/bad-input/frames.tsv" "${frames}")
file(STRINGS "${FIXTURE}/frames.tsv" rows)
list(GET rows 1 first_frame)
string(REPLACE " " ";" first_fields "${first_frame}")
list(GET first_fields 4 first_rgb)
foreach(bad nan inf -inf)
    set(changed_fields "${first_fields}")
    list(REMOVE_AT changed_fields 6)
    list(INSERT changed_fields 6 "${bad}")
    string(JOIN " " changed ${changed_fields})
    string(REPLACE "${first_frame}" "${changed}" invalid_frames "${frames}")
    file(WRITE "${WORK}/bad-input/frames.tsv" "${invalid_frames}")
    run(65 --dataset "${WORK}/bad-input" --output "${WORK}/not-created")
endforeach()
file(MAKE_DIRECTORY "${WORK}/corrupt-input/rgb")
file(CREATE_LINK "${FIXTURE}/depth" "${WORK}/corrupt-input/depth" SYMBOLIC)
file(WRITE "${WORK}/corrupt-input/${first_rgb}" "not a PNG\n")
foreach(row IN LISTS rows)
    if(row MATCHES "^[0-9]+ ")
        string(REPLACE " " ";" row_fields "${row}")
        list(GET row_fields 4 image)
        if(NOT image STREQUAL first_rgb)
            file(CREATE_LINK "${FIXTURE}/${image}" "${WORK}/corrupt-input/${image}" SYMBOLIC)
        endif()
    endif()
endforeach()
file(WRITE "${WORK}/corrupt-input/frames.tsv" "${frames}")
run(65 --dataset "${WORK}/corrupt-input" --output "${WORK}/not-created")
execute_process(COMMAND "${CHECKER}" --dataset "${WORK}/corrupt-input" --results "${WORK}/map"
    RESULT_VARIABLE corrupt_checker_status OUTPUT_VARIABLE corrupt_checker_output ERROR_VARIABLE corrupt_checker_diagnostics)
if(NOT "${corrupt_checker_status}" STREQUAL "1")
    message(FATAL_ERROR "Independent PNG reader accepted corrupt PNG: ${corrupt_checker_diagnostics}")
endif()
if(EXISTS "${WORK}/not-created")
    message(FATAL_ERROR "Corrupt input created output")
endif()
run(74 --dataset "${FIXTURE}" --output "${WORK}/missing-parent/map")
file(MAKE_DIRECTORY "${WORK}/tampered")
foreach(name poses.csv cloud.csv map.ply map.db)
    file(COPY "${WORK}/map/${name}" DESTINATION "${WORK}/tampered")
endforeach()
file(READ "${WORK}/map/poses.csv" poses)
file(READ "${WORK}/map/cloud.csv" cloud)
file(STRINGS "${WORK}/map/poses.csv" pose_lines)
list(GET pose_lines 1 first_pose)
string(REPLACE "," ";" pose_fields "${first_pose}")
foreach(column RANGE 3 14)
    foreach(bad 10 nan inf -inf)
        set(changed_fields "${pose_fields}")
        list(REMOVE_AT changed_fields ${column})
        list(INSERT changed_fields ${column} "${bad}")
        string(JOIN "," changed ${changed_fields})
        string(REPLACE "${first_pose}" "${changed}" corrupted "${poses}")
        file(WRITE "${WORK}/tampered/poses.csv" "${corrupted}")
        check(1 "${WORK}/tampered")
    endforeach()
endforeach()
file(WRITE "${WORK}/tampered/poses.csv" "${poses}")
foreach(bad 100 nan inf -inf)
    string(REGEX REPLACE "\n1,([0-9]+),([0-9]+),[^,]+," "\n1,\\1,\\2,${bad}," corrupted "${cloud}")
    file(WRITE "${WORK}/tampered/cloud.csv" "${corrupted}")
    check(1 "${WORK}/tampered")
endforeach()
file(WRITE "${WORK}/tampered/cloud.csv" "${cloud}extra\n")
check(1 "${WORK}/tampered")
string(REGEX REPLACE "[^\n]+\n$" "" truncated "${cloud}")
file(WRITE "${WORK}/tampered/cloud.csv" "${truncated}")
check(1 "${WORK}/tampered")
file(WRITE "${WORK}/tampered/cloud.csv" "${cloud}")
file(APPEND "${WORK}/tampered/map.ply" "extra\n")
check(1 "${WORK}/tampered")
